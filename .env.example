# Frontend (Vite) environment variables. Copy to .env and fill in.
# Supabase project used for login (Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API base URL (Express server in ./server). Include the /api suffix.
VITE_API_URL=http://localhost:3001/api

# GitHub repo (owner/name) whose Actions status is shown in the sidebar & CI/CD panel
VITE_GITHUB_REPO=BibinSanju/Agile-Tracker

# Optional: x-api-key header for legacy routes when the server sets API_KEY
# VITE_API_KEY=

# Dev/E2E only: skip Supabase login with a stub ADMIN session.
# Ignored in production builds. Set automatically by playwright.config.ts.
# VITE_E2E_AUTH_BYPASS=true
